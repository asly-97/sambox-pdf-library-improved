+    /**
+     * Stores the inheritable attribute identified by the given key on the
+     * given page dictionary, resolved through the page tree the page is
+     * currently part of, but only when the page does not define the
+     * attribute itself. Nothing is stored when no ancestor defines it
+     * either, so spec fallbacks (e.g. CropBox defaulting to MediaBox) keep
+     * being derived rather than frozen into a stored value.
+     */
+    private static void materializeInheritable(COSDictionary node, COSName key)
+    {
+        if (node.getDictionaryObject(key) == null)
+        {
+            COSBase value = getInheritableAttribute(node, key);
+            if (value instanceof COSArray)
+            {
+                COSArray copy = new COSArray();
+                copy.addAll((COSArray) value);
+                node.setItem(key, copy);
+            }
+        }
+    }
+
+    /**
+     * Copies a COS structure: dictionaries and arrays are duplicated
+     * (recursively), every other value is shared. Used so a data structure
+     * taken over from another document stops aliasing the source's mutable
+     * dictionaries while its leaf objects keep being ordinary references
+     * the writer copies into the new file.
+     */
+    private static COSBase deepCopy(COSBase value)
+    {
+        return deepCopy(value,
+                Collections.newSetFromMap(new IdentityHashMap<>()));
+    }
+
+    private static COSBase deepCopy(COSBase value, Set<COSBase> visited)
+    {
+        // entries of a parsed dictionary are usually indirect references
+        // (COSObject) to the actual dictionary or array; copying must
+        // follow the reference and duplicate what it points at, otherwise
+        // the copy still aliases the source's dictionaries
+        COSBase unwrapped = value.getCOSObject();
+        if (unwrapped instanceof COSStream)
+        {
+            // a stream is a dictionary plus data the writer reads back
+            // from wherever the stream was parsed; copying only the
+            // dictionary entries would produce a dictionary without the
+            // data. Copy the entries (minus the ones describing the
+            // source's stored bytes) and the decoded data itself, eagerly,
+            // while the source document is still open.
+            if (!visited.add(unwrapped))
+            {
+                return unwrapped;
+            }
+            COSStream sourceStream = (COSStream) unwrapped;
+            COSStream copy = new COSStream();
+            for (Map.Entry<COSName, COSBase> entry : sourceStream.entrySet())
+            {
+                COSName key = entry.getKey();
+                if (COSName.LENGTH.equals(key) || COSName.FILTER.equals(key)
+                        || COSName.DECODE_PARMS.equals(key) || COSName.F.equals(key)
+                        || COSName.F_FILTER.equals(key)
+                        || COSName.F_DECODE_PARMS.equals(key) || COSName.DL.equals(key))
+                {
+                    continue;
+                }
+                copy.setItem(key, deepCopy(entry.getValue(), visited));
+            }
+            try (InputStream in = sourceStream.getUnfilteredStream();
+                    OutputStream out = copy.createUnfilteredStream())
+            {
+                in.transferTo(out);
+            }
+            catch (IOException e)
+            {
+                throw new IllegalStateException("Failed to copy stream data", e);
+            }
+            return copy;
+        }
+        if (unwrapped instanceof COSDictionary)
+        {
+            if (!visited.add(unwrapped))
+            {
+                return unwrapped;
+            }
+            COSDictionary copy = new COSDictionary();
+            for (Map.Entry<COSName, COSBase> entry : ((COSDictionary) unwrapped)
+                    .entrySet())
+            {
+                copy.setItem(entry.getKey(), deepCopy(entry.getValue(), visited));
+            }
+            return copy;
+        }
+        if (unwrapped instanceof COSArray)
+        {
+            if (!visited.add(unwrapped))
+            {
+                return unwrapped;
+            }
+            COSArray copy = new COSArray();
+            for (COSBase item : (COSArray) unwrapped)
+            {
+                copy.add(deepCopy(item, visited));
+            }
+            return copy;
+        }
+        return value;
+    }
